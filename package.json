{
  "name": "raeburn-talent",
  "version": "0.2.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "services/*",
    "apps/*",
    "connectors/*"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "test": "vitest run --passWithNoTests",
    "infra:up": "docker compose -f infrastructure/docker-compose.yml up -d && npm run object-storage:init",
    "infra:down": "docker compose -f infrastructure/docker-compose.yml down",
    "service:jobs": "npm --workspace @raeburn/jobs-service start",
    "service:candidates": "npm --workspace @raeburn/candidates-service start",
    "service:applications": "npm --workspace @raeburn/applications-service start",
    "service:gateway": "npm --workspace @raeburn/api-gateway start",
    "platform:bootstrap": "node scripts/bootstrap-local.mjs",
    "platform:dev": "node scripts/dev-platform.mjs",
    "careers:dev": "npm --workspace @raeburn/careers-web run dev",
    "admin:dev": "npm --workspace @raeburn/talent-admin run dev",
    "build:careers": "npm --workspace @raeburn/careers-web run build",
    "build:admin": "npm --workspace @raeburn/talent-admin run build",
    "build:frontends": "npm run build:careers && npm run build:admin",
    "migrate:services": "node scripts/migrate-services.mjs",
    "check": "npm run typecheck && npm run test && npm run build:frontends",
    "migrate:validate": "node scripts/validate-migrations.mjs",
    "stage9:validate": "node scripts/validate-stage9-runtime.mjs && npm run migrate:validate",
    "db:backup": "node scripts/backup-service-databases.mjs",
    "db:restore-drill": "node scripts/restore-drill.mjs",
    "db:provision-roles": "node scripts/provision-db-roles.mjs",
    "synthetic:candidate": "node scripts/synthetic-candidate-journey.mjs",
    "db:maintenance": "node scripts/db-maintenance.mjs",
    "stage9:production-gate": "node scripts/verify-stage9-production.mjs",
    "test:unit": "vitest run packages services/documents/src/scan-policy.test.ts --passWithNoTests",
    "test:e2e": "playwright test",
    "test:integration": "node scripts/ci-integration-smoke.mjs",
    "test:load": "node scripts/load-smoke.mjs",
    "test:failure": "node scripts/failure-injection.mjs",
    "test:contracts": "vitest run packages/events/src/registry.test.ts packages/policy/src/index.test.ts",
    "stage10:validate": "npm run migrate:validate && npm run test:contracts && npm run typecheck",
    "test:security-integration": "node scripts/ci-security-isolation.mjs",
    "stage10:completion-gate": "node scripts/verify-stage10-completion.mjs",
    "object-storage:init": "node scripts/init-object-storage.mjs",
    "stage11:completion-gate": "node scripts/verify-stage11-completion.mjs && vitest run services/analytics/src/reporting.test.ts",
    "storybook": "npm run storybook:prepare && storybook dev -p 6006",
    "storybook:build": "npm run storybook:prepare && storybook build --output-dir storybook-static",
    "storybook:prepare": "npm install --no-save --package-lock=false --ignore-scripts storybook@10.6.0 @storybook/nextjs-vite@10.6.0"
  },
  "dependencies": {
    "@prisma/client": "6.12.0",
    "bcryptjs": "^3.0.2",
    "date-fns": "^4.1.0",
    "jose": "^6.1.0",
    "next": "^16.3.6",
    "nodemailer": "^10.0.11",
    "pg": "^8.16.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.18.6",
    "@types/nodemailer": "^7.0.1",
    "@types/pg": "^8.15.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "^9.36.0",
    "eslint-config-next": "^16.3.6",
    "prisma": "6.12.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^5.0.2",
    "@playwright/test": "^1.55.0",
    "@axe-core/playwright": "^4.10.2"
  }
}
