NODE_ENV=production
DEFAULT_TENANT_ID=tenant_raeburn_group
ENFORCE_TENANT_ENTITLEMENTS=true

# Managed PostgreSQL: omit the trailing database name.
# Example: postgresql://talent_runtime:PASSWORD@HOST:25060
DATABASE_BASE_URL=

# Persistent NATS
NATS_URL=nats://NATS_PRIVATE_IP:4222

# Private Cloudflare R2
R2_ENDPOINT=https://CLOUDFLARE_ACCOUNT_ID.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=raeburn-talent-production-documents
R2_FORCE_PATH_STYLE=false

# Service/authentication secrets
SERVICE_AUTH_SECRET=
TENANT_ENCRYPTION_MASTER_KEY=
APPLICATION_UPLOAD_SECRET=
MFA_ENCRYPTION_KEY=
AUTH_SECRET=
AUTH_KEY_ID=talent-primary
AUTH_PRIVATE_KEY_PEM=
AUTH_PUBLIC_KEY_PEM=
CAREERS_ROUTING_SECRET=

# WebAuthn
WEBAUTHN_RP_ID=talent.theraeburngroup.com
WEBAUTHN_ORIGIN=https://talent.theraeburngroup.com

# Initial admin only — remove/rotate after first real admin exists
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# Public URLs / TLS
API_DOMAIN=api.talent.theraeburngroup.com
TLS_CONTACT_EMAIL=
TALENT_ADMIN_URL=https://talent.theraeburngroup.com
CAREERS_BASE_URL=https://careers.theraeburngroup.com
CORS_ORIGINS=https://talent.theraeburngroup.com,https://careers.theraeburngroup.com

# SMTP
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Raeburn Talent <careers@theraeburngroup.com>

# Malware scanner
DOCUMENT_SCAN_MODE=production
MALWARE_SCANNER_URL=http://malware-scanner:4130/scan
MALWARE_SCANNER_TOKEN=
MAX_SCAN_BYTES=15728640

# Optional OIDC provider secrets
GOOGLE_OIDC_CLIENT_SECRET=
MICROSOFT_OIDC_CLIENT_SECRET=
