FROM node:22-bookworm-slim
WORKDIR /app
ENV NODE_ENV=production
COPY package.json package-lock.json ./
COPY packages ./packages
COPY services ./services
COPY connectors ./connectors
COPY infrastructure/production/deployment-units.json ./infrastructure/production/deployment-units.json
COPY scripts/run-deployment-unit.mjs ./scripts/run-deployment-unit.mjs
RUN npm ci --omit=dev --ignore-scripts && rm -rf /usr/local/lib/node_modules/npm /usr/local/bin/npm /usr/local/bin/npx
USER node
CMD ["node","scripts/run-deployment-unit.mjs"]
